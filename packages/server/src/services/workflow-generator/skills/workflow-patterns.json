        }
    },
    "fallback_rules": [
        {
            "condition": "包含'图片'或'图像'或'画'",
            "category": "image-generation",
            "confidence": 0.85,
            "reason": "明确的图片生成需求"
        },
        {
            "condition": "包含'代码'或'编程'或'函数'",
            "category": "code-assistant",
            "confidence": 0.82,
            "reason": "明确的代码相关需求"
        },
        {
            "condition": "包含'文档'或'知识库'或'检索'",
            "category": "rag",
            "confidence": 0.8,
            "reason": "明确的文档检索需求"
        },
        {
            "condition": "包含'数据'和('分析'或'处理'或'统计')",
            "category": "data-analysis",
            "confidence": 0.78,
            "reason": "明确的数据分析需求"
        },
        {
            "condition": "包含'自动化'或'批处理'或'定时'",
            "category": "automation",
            "confidence": 0.75,
            "reason": "明确的自动化需求"
        }
    ],
    "node_compatibility": {
        "ChatDeepseek": {
            "compatibleWith": ["BufferMemory", "ConversationChain", "LLMChain"],
            "bestFor": ["chatbot", "code-assistant", "rag"],
            "models": {
                "deepseek-chat": "通用对话",
                "deepseek-coder": "代码生成"
            }
        },
        "BufferMemory": {
            "compatibleWith": ["ConversationChain"],
            "bestFor": ["chatbot"],
            "config": {
                "memoryKey": "chat_history",
                "inputKey": "input"
            }
        },
        "JimengImageGen": {
            "compatibleWith": [],
            "bestFor": ["image-generation"],
            "standalone": true
        }
    },
    "layout_guidelines": {
        "simple": {
            "description": "简单工作流（1-3个节点）",
            "positions": {
                "input": { "x": 400, "y": 400 },
                "process": { "x": 1000, "y": 400 },
                "output": { "x": 1600, "y": 400 }
            },
            "spacing": {
                "horizontal": 600,
                "vertical": 300
            }
        },
        "medium": {
            "description": "中等复杂度（4-6个节点）",
            "positions": {
                "input": { "x": 400, "y": 200 },
                "memory": { "x": 400, "y": 750 },
                "process": { "x": 1000, "y": 400 },
                "output": { "x": 1600, "y": 400 }
            },
            "spacing": {
                "horizontal": 600,
                "vertical": 300
            }
        },
        "complex": {
            "description": "复杂工作流（7+个节点）",
            "grid": {
                "columns": 3,
                "startX": 400,
                "startY": 200,
                "spacingX": 600,
                "spacingY": 400
            }
        }
    },
    "validation_rules": {
        "node": {
            "required_fields": ["id", "type", "data", "position"],
            "id_pattern": "^[a-zA-Z]+_\\d+$",
            "position_constraints": {
                "x_min": 0,
                "y_min": 0,
                "x_max": 2400,
                "y_max": 2000
            }
        },
        "edge": {
            "required_fields": ["source", "target", "type", "id"],
            "required_type": "buttonedge",
            "no_cycles": true
        },
        "workflow": {
            "min_nodes": 1,
            "max_nodes": 20,
            "must_have_output": true
        }
    }
}
